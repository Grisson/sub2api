# =============================================================================
# Sub2API on AKS - settings shared by azure/create-aks.sh and scripts/*.sh
# =============================================================================
#   cp config.env.example config.env    # then edit
#
# No passwords belong in this file. scripts/deploy.sh asks for user names and
# passwords interactively (or generates them) and stores them only as
# Kubernetes Secrets inside the cluster.

# ---------------------------------------------------------------- Azure -----
# Leave empty to use the subscription currently selected in "az account show".
AZ_SUBSCRIPTION_ID=
AZ_RESOURCE_GROUP=sub2api-prod-rg
AZ_LOCATION=eastasia

# ------------------------------------------------------------------ AKS -----
AKS_CLUSTER_NAME=sub2api-aks
AKS_NODE_VM_SIZE=Standard_D4s_v5
AKS_NODE_MIN=3
AKS_NODE_MAX=6
# Availability zones for nodes and the public IP. Set to "" in regions
# without availability zones.
AKS_ZONES="1 2 3"
# Pod network range (Azure CNI Overlay). Also used as the app's trusted-proxy range.
AKS_POD_CIDR=10.244.0.0/16
# Leave empty for the AKS default version.
AKS_KUBERNETES_VERSION=
# STRONGLY RECOMMENDED: comma-separated public IPs/CIDRs allowed to reach the
# Kubernetes API server, e.g. "203.0.113.10/32,198.51.100.0/24".
# Empty = the API server is reachable from any address (still Entra ID protected).
AKS_API_AUTHORIZED_IPS=
# Optional paid add-ons.
AKS_ENABLE_DEFENDER=false      # Microsoft Defender for Containers
AKS_ENABLE_MONITORING=false    # Container insights (Log Analytics)

# Optional: Azure Container Registry to create and attach (globally unique,
# 5-50 lowercase alphanumerics). Needed only if you build your own image with
# scripts/build-image.sh.
ACR_NAME=

# ----------------------------------------------------------- Application ----
# Public host name clients will use. Point its DNS A record at the public IP
# printed by azure/create-aks.sh.
DOMAIN=api.example.com

# Image to run. Pin a released version tag for production instead of "latest".
# With your own registry: SUB2API_IMAGE=<ACR_NAME>.azurecr.io/sub2api
SUB2API_IMAGE=weishaw/sub2api
SUB2API_TAG=latest

# Resource sizing of the pods.
#   standard : needs >= 8 vCPUs of nodes (e.g. 2-3 x Standard_D4s_v5)
#   small    : fits 4 vCPUs in total (2 x Standard_D2s_v5); use with
#              AKS_NODE_VM_SIZE=Standard_D2s_v5, AKS_NODE_MIN=2, AKS_NODE_MAX=2
SIZE_PROFILE=standard

# Affects billing day boundaries, statistics and log timestamps.
TIMEZONE=Asia/Shanghai

# ------------------------------------------------------------------ TLS -----
# selfsigned  : script generates a self-signed certificate (testing only)
# byo         : bring your own certificate (set TLS_CERT_FILE / TLS_KEY_FILE)
# letsencrypt : cert-manager + Let's Encrypt via DNS-01; the domain's zone
#               must be hosted in Azure DNS (set the three values below
#               BEFORE running azure/create-aks.sh). Requires helm.
TLS_MODE=selfsigned

# byo: PEM files. Use paths relative to deploy/k8s (e.g. certs/fullchain.pem).
TLS_CERT_FILE=
TLS_KEY_FILE=

# letsencrypt:
ACME_EMAIL=
DNS_ZONE_NAME=
DNS_ZONE_RESOURCE_GROUP=
